# regenerated by run_pipeline.py
data/processed/*
models/*
# downloaded sources (TAF, BTS, airports) and Stage 1 outputs, verified by .source.json receipts
data/external/*
data/stage1/
# superseded by data/external/taf/ (Keith's earlier TAF download)
data/weather/raw_taf/
# stale first-prototype output
data/model/
__pycache__/
.pytest_cache/
*.pyc
.venv/
.idea/
.DS_Store
DataSet/.DS_Store

# secrets and local env (never commit)
.env
**/.env

# jho/aerocast_data pipeline: raw downloads and big intermediate tables are re-created by run_all.py
**/data/raw/
*.part
*.log
**/processed/bts_flights.parquet
**/processed/flights_horizon.parquet
**/processed/aar_horizon.parquet
# keep the small trained models the jho dashboard loads (the root models/ rule above would hide them)
!jho/aerocast_data/data/models/
# jho intermediates, re-created by run_all.py (the jho dashboard only needs the two *_predictions files)
jho/aerocast_data/data/processed/metar*.parquet
jho/aerocast_data/data/processed/taf.parquet
jho/aerocast_data/data/processed/airport_hourly.parquet
# duplicate of data/weather/hourly_atl_dfw.csv
jho/data/weather/

# Small replay snapshot required by the web dashboard on a fresh checkout.
!data/processed/hourly_weather.csv
!data/processed/aar_predictions.parquet
!data/processed/delay_test_predictions.parquet
!data/processed/delay_table.parquet
!data/external/airports.dat
!models/delay_lead[3-9].joblib
!models/delay_lead1[0-2].joblib
.vercel/

.claude/
